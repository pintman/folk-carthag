builtin-programs/web/setup.folk

{display glfw} {when {Wish $::thisNode uses display "glfw" with width 1920 height 1080 refreshRate -1} with environment {}}
{camera /dev/v4l/by-path/pci-0000:00:14.0-usb-0:9:1.0-video-index0 detects tags} {when {Wish camera "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:9:1.0-video-index0" detects tags} with environment {}}
{exposure /dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0} {when {
          Wish camera /dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0 uses exposure time 0 us
        } with environment {}}
{camera /dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0} {when {Wish $::thisNode uses camera "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0" with width 1280 height 720 framerate 30.0} with environment {}}
{camera /dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0 detects tags} {when {Wish camera "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0" detects tags} with environment {}}
